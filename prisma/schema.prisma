generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserType {
  STUDENT
  LECTURER
  ADMINISTRATOR
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
  DEFERRED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
  FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum GradeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

enum SemesterStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

// ==========================================
// 1. AUTHENTICATION
// ==========================================

model Users {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique @db.VarChar(255)
  username        String       @unique @db.VarChar(100)
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  userType        UserType     @map("user_type")
  status          UserStatus   @default(PENDING_VERIFICATION)
  firstName       String       @map("first_name") @db.VarChar(100)
  lastName        String       @map("last_name") @db.VarChar(100)
  phone           String?      @db.VarChar(50)
  lastLoginAt     DateTime?    @map("last_login_at")
  lastLoginIp     String?      @map("last_login_ip") @db.VarChar(45)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  // Relations
  student         Students?
  lecturer        Lecturers?
  administrator   Administrators?
  staff           Staff?
  roles           UserRoles[]
  directPermissions UserPermissions[]
  refreshTokens   RefreshTokens[]
  sessions        Sessions[]
  passwordResets  PasswordResets[]
  loginHistory    LoginHistory[]
  auditLogs       AuditLogs[]
  notifications   Notifications[]
  sentMessages    Messages[]      @relation("SentMessages")
  receivedMessages Messages[]     @relation("ReceivedMessages")

  @@map("users")
}

model Roles {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  slug        String           @unique @db.VarChar(100)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  users       UserRoles[]
  permissions RolePermissions[]

  @@map("roles")
}

model Permissions {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  slug        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(50)
  action      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  roles       RolePermissions[]
  users       UserPermissions[]

  @@map("permissions")
}

model UserRoles {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Roles    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermissions {
  id           String      @id @default(uuid()) @db.Uuid
  roleId       String      @map("role_id") @db.Uuid
  permissionId String      @map("permission_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  role         Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissions {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  permissionId String      @map("permission_id") @db.Uuid
  granted      Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  user         Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model RefreshTokens {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Sessions {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionId    String   @unique @map("session_id") @db.VarChar(255)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  device       String?  @db.VarChar(100)
  expiresAt    DateTime @map("expires_at")
  lastActivity DateTime @default(now()) @map("last_activity")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user         Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResets {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model LoginHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  ipAddress   String   @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  device      String?  @db.VarChar(100)
  location    String?  @db.VarChar(255)
  success     Boolean  @default(true)
  failReason  String?  @map("fail_reason") @db.VarChar(255)
  loggedAt    DateTime @default(now()) @map("logged_at")

  // Relations
  user        Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
}

model AuditLogs {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String?     @map("entity_id") @db.Uuid
  oldValue    Json?       @map("old_value")
  newValue    Json?       @map("new_value")
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  user        Users?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ==========================================
// 2. ACADEMIC STRUCTURE
// ==========================================

model Faculties {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(255)
  code        String       @unique @db.VarChar(50)
  description String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  // Relations
  departments Departments[]

  @@map("faculties")
}

model Departments {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(255)
  code        String       @unique @db.VarChar(50)
  description String?      @db.Text
  facultyId   String       @map("faculty_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  // Relations
  faculty     Faculties    @relation(fields: [facultyId], references: [id])
  programs    Programs[]
  lecturers   Lecturers[]
  courses     Courses[]

  @@unique([name, facultyId])
  @@map("departments")
}

model Programs {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(255)
  code         String       @unique @db.VarChar(50)
  description  String?      @db.Text
  departmentId String       @map("department_id") @db.Uuid
  durationYears Int         @map("duration_years") @default(4)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  // Relations
  department   Departments  @relation(fields: [departmentId], references: [id])
  students     StudentPrograms[]

  @@unique([name, departmentId])
  @@map("programs")
}

model AcademicYears {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(100) // e.g., 2023/2024
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  isActive    Boolean      @default(false) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  semesters   Semesters[]

  @@map("academic_years")
}

model Semesters {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(100) // e.g., First Semester
  academicYearId String      @map("academic_year_id") @db.Uuid
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  status      SemesterStatus @default(UPCOMING)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  academicYear AcademicYears @relation(fields: [academicYearId], references: [id])
  offerings    CourseOfferings[]
  results      Grades[]

  @@unique([name, academicYearId])
  @@map("semesters")
}

model Levels {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50) // e.g., 100, 200, Graduate
  code        Int      @unique // e.g., 100
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  students    Students[]
  courses     Courses[]

  @@map("levels")
}

// ==========================================
// 3. USERS PROFILES
// ==========================================

model Students {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @unique @map("user_id") @db.Uuid
  studentNo     String         @unique @map("student_no") @db.VarChar(50)
  gender        Gender
  dateOfBirth   DateTime       @map("date_of_birth") @db.Date
  levelId       String         @map("level_id") @db.Uuid
  status        StudentStatus  @default(ACTIVE)
  admissionDate DateTime       @map("admission_date") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  // Relations
  user          Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         Levels         @relation(fields: [levelId], references: [id])
  programs      StudentPrograms[]
  enrollments   Enrollments[]
  statusHistory StudentStatusHistories[]
  attendance    AttendanceRecords[]

  @@map("students")
}

model Lecturers {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  staffNo       String       @unique @map("staff_no") @db.VarChar(50)
  departmentId  String       @map("department_id") @db.Uuid
  designation   String?      @db.VarChar(100)
  specialization String?     @db.VarChar(255)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  // Relations
  user          Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Departments  @relation(fields: [departmentId], references: [id])
  courseAssignments CourseAssignments[]
  offerings     CourseOfferings[]

  @@map("lecturers")
}

model Administrators {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  staffNo       String       @unique @map("staff_no") @db.VarChar(50)
  department    String?      @db.VarChar(100)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  user          Users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("administrators")
}

model Staff {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  staffNo       String       @unique @map("staff_no") @db.VarChar(50)
  jobTitle      String       @map("job_title") @db.VarChar(100)
  department    String?      @db.VarChar(100)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  user          Users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff")
}

// ==========================================
// 4. COURSES
// ==========================================

model Courses {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique @db.VarChar(20)
  title         String       @db.VarChar(255)
  description   String?      @db.Text
  credits       Int
  departmentId  String       @map("department_id") @db.Uuid
  levelId       String       @map("level_id") @db.Uuid
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  // Relations
  department    Departments  @relation(fields: [departmentId], references: [id])
  level         Levels       @relation(fields: [levelId], references: [id])
  prerequisites CoursePrerequisites[] @relation("CourseMain")
  requiredFor   CoursePrerequisites[] @relation("CourseRequired")
  offerings     CourseOfferings[]
  assignments   CourseAssignments[]

  @@map("courses")
}

model CoursePrerequisites {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  prerequisiteId   String   @map("prerequisite_id") @db.Uuid
  isMandatory      Boolean  @default(true) @map("is_mandatory")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  course           Courses  @relation("CourseMain", fields: [courseId], references: [id])
  prerequisite     Courses  @relation("CourseRequired", fields: [prerequisiteId], references: [id])

  @@unique([courseId, prerequisiteId])
  @@map("course_prerequisites")
}

model CourseOfferings {
  id            String       @id @default(uuid()) @db.Uuid
  courseId      String       @map("course_id") @db.Uuid
  semesterId    String       @map("semester_id") @db.Uuid
  lecturerId    String?      @map("lecturer_id") @db.Uuid
  capacity      Int?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  course        Courses      @relation(fields: [courseId], references: [id])
  semester      Semesters    @relation(fields: [semesterId], references: [id])
  lecturer      Lecturers?   @relation(fields: [lecturerId], references: [id])
  enrollments   Enrollments[]
  classes       Classes[]
  attendanceSessions AttendanceSessions[]

  @@unique([courseId, semesterId])
  @@map("course_offerings")
}

model CourseAssignments {
  id            String    @id @default(uuid()) @db.Uuid
  lecturerId    String    @map("lecturer_id") @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  lecturer      Lecturers @relation(fields: [lecturerId], references: [id])
  course        Courses   @relation(fields: [courseId], references: [id])

  @@unique([lecturerId, courseId])
  @@map("course_assignments")
}

// ==========================================
// 5. CLASSES
// ==========================================

model Classes {
  id             String       @id @default(uuid()) @db.Uuid
  offeringId     String       @map("offering_id") @db.Uuid
  name           String       @db.VarChar(50) // e.g., Group A
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  offering       CourseOfferings @relation(fields: [offeringId], references: [id])
  sections       ClassSections[]
  timetables     Timetables[]

  @@unique([offeringId, name])
  @@map("classes")
}

model ClassSections {
  id          String   @id @default(uuid()) @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  name        String   @db.VarChar(50) // e.g., Section 1
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  class       Classes  @relation(fields: [classId], references: [id])

  @@map("class_sections")
}

// ==========================================
// 6. STUDENT REGISTRATION
// ==========================================

model Enrollments {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  offeringId    String           @map("offering_id") @db.Uuid
  status        EnrollmentStatus @default(PENDING)
  grade         String?          @db.VarChar(5)
  gradePoint    Decimal?         @map("grade_point") @db.Decimal(3,2)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  student       Students         @relation(fields: [studentId], references: [id])
  offering      CourseOfferings  @relation(fields: [offeringId], references: [id])
  grades        Grades[]

  @@unique([studentId, offeringId])
  @@map("enrollments")
}

model StudentPrograms {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  isPrimary   Boolean  @default(true) @map("is_primary")
  enrolledAt  DateTime @default(now()) @map("enrolled_at")

  // Relations
  student     Students @relation(fields: [studentId], references: [id])
  program     Programs @relation(fields: [programId], references: [id])

  @@unique([studentId, programId])
  @@map("student_programs")
}

model StudentStatusHistories {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @map("student_id") @db.Uuid
  oldStatus   StudentStatus @map("old_status")
  newStatus   StudentStatus @map("new_status")
  reason      String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")

  // Relations
  student     Students      @relation(fields: [studentId], references: [id])

  @@map("student_status_history")
}

// ==========================================
// 7. ATTENDANCE
// ==========================================

model AttendanceSessions {
  id            String           @id @default(uuid()) @db.Uuid
  offeringId    String           @map("offering_id") @db.Uuid
  sessionDate   DateTime         @map("session_date") @db.Date
  startTime     DateTime         @map("start_time") @db.Time
  endTime       DateTime         @map("end_time") @db.Time
  description   String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")

  // Relations
  offering      CourseOfferings  @relation(fields: [offeringId], references: [id])
  records       AttendanceRecords[]

  @@map("attendance_sessions")
}

model AttendanceRecords {
  id          String           @id @default(uuid()) @db.Uuid
  sessionId   String           @map("session_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  status      AttendanceStatus @default(PRESENT)
  remarks     String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")

  // Relations
  session     AttendanceSessions @relation(fields: [sessionId], references: [id])
  student     Students           @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

// ==========================================
// 8. EXAMINATION
// ==========================================

model AssessmentTypes {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100) // e.g., Continuous Assessment, Final Exam
  weightage   Int      // e.g., 40 (for 40%)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  assessments Assessments[]

  @@map("assessment_types")
}

model Assessments {
  id              String          @id @default(uuid()) @db.Uuid
  assessmentTypeId String         @map("assessment_type_id") @db.Uuid
  title           String          @db.VarChar(255)
  maxMarks        Int             @map("max_marks")
  createdAt       DateTime        @default(now()) @map("created_at")

  // Relations
  assessmentType  AssessmentTypes @relation(fields: [assessmentTypeId], references: [id])
  grades          Grades[]

  @@map("assessments")
}

model Grades {
  id            String       @id @default(uuid()) @db.Uuid
  enrollmentId  String       @map("enrollment_id") @db.Uuid
  assessmentId  String       @map("assessment_id") @db.Uuid
  semesterId    String       @map("semester_id") @db.Uuid
  marksObtained Decimal      @map("marks_obtained") @db.Decimal(5,2)
  status        GradeStatus  @default(DRAFT)
  remarks       String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  enrollment    Enrollments  @relation(fields: [enrollmentId], references: [id])
  assessment    Assessments  @relation(fields: [assessmentId], references: [id])
  semester      Semesters    @relation(fields: [semesterId], references: [id])
  changes       GradeChanges[]

  @@unique([enrollmentId, assessmentId])
  @@map("grades")
}

model GradeChanges {
  id          String     @id @default(uuid()) @db.Uuid
  gradeId     String     @map("grade_id") @db.Uuid
  oldMarks    Decimal    @map("old_marks") @db.Decimal(5,2)
  newMarks    Decimal    @map("new_marks") @db.Decimal(5,2)
  reason      String     @db.Text
  changedBy   String     @map("changed_by") @db.Uuid // Staff ID or User ID
  createdAt   DateTime   @default(now()) @map("created_at")

  // Relations
  grade       Grades     @relation(fields: [gradeId], references: [id])

  @@map("grade_changes")
}

// ==========================================
// 9. TIMETABLE
// ==========================================

model Buildings {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  code        String   @unique @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rooms       Rooms[]

  @@map("buildings")
}

model Rooms {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  code        String   @unique @db.VarChar(50)
  capacity    Int
  buildingId  String   @map("building_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  building    Buildings @relation(fields: [buildingId], references: [id])
  timetables  Timetables[]

  @@unique([name, buildingId])
  @@map("rooms")
}

model Timetables {
  id          String   @id @default(uuid()) @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  roomId      String?  @map("room_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week") // 1-7
  startTime   DateTime @map("start_time") @db.Time
  endTime     DateTime @map("end_time") @db.Time
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  class       Classes  @relation(fields: [classId], references: [id])
  room        Rooms?   @relation(fields: [roomId], references: [id])

  @@map("timetables")
}

// ==========================================
// 10. COMMUNICATION
// ==========================================

model Announcements {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  content     String   @db.Text
  isPublic    Boolean  @default(false) @map("is_public")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model Notifications {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  title       String           @db.VarChar(255)
  message     String           @db.Text
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  // Relations
  user        Users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Messages {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @map("sender_id") @db.Uuid
  receiverId  String   @map("receiver_id") @db.Uuid
  subject     String?  @db.VarChar(255)
  content     String   @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  sender      Users    @relation("SentMessages", fields: [senderId], references: [id])
  receiver    Users    @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@map("messages")
}
