# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=UniCore ERP
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://unicore:unicore_secret@localhost:5432/unicore_erp?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_TTL=604800

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@unicore.edu

# Payment Gateways
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MTN_MOMO_API_KEY=
ORANGE_MONEY_API_KEY=

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
