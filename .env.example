# Database Connection
DATABASE_URL="postgresql://unicore:YOUR_PASSWORD@localhost:5432/unicore_erp?schema=public"

# Authentication
JWT_ACCESS_SECRET=replace_with_secure_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application
PORT=4000
NODE_ENV=development
APP_NAME="UniCore ERP"
API_PREFIX="api/v1"

# Infrastructure
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_TTL=604800

# Security
THROTTLE_TTL=60
THROTTLE_LIMIT=100
CORS_ORIGINS=http://localhost:3000
